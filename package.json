{
  "name": "clearance-writers",
  "version": "0.0.0",
  "description": "Inspectable firewall writers for Sarambar Clearance. Adds and removes temporary allow rules. Azure SQL and PostgreSQL Flexible Server in this version.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "roles",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test --test-reporter spec \"dist/test/**/*.test.js\"",
    "live-smoke": "tsc -p tsconfig.json && node dist/scripts/live-smoke.js",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarambar/clearance-writers.git"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
